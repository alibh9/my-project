# ---- عام ----
PORT=3000
SHOP_NAME=مركز المكيفات
SHOP_PHONE=+966500000000
# الإزاحة الزمنية لمدينة المحل (لا يوجد توقيت صيفي في معظم الدول العربية)
SHOP_UTC_OFFSET=+03:00
# كود الدولة الافتراضي لأرقام العملاء المكتوبة بصيغة محلية (تبدأ بـ 0)
DEFAULT_COUNTRY_CODE=966
# مسار قاعدة البيانات SQLite
DATABASE_PATH=./data/bookings.db
# عدد الأيام المسموح حجزها مقدماً
MAX_ADVANCE_DAYS=60
# إلغاء الثقة بالبروكسي (true فقط خلف Nginx/Cloudflare)
TRUST_PROXY=false

# ---- لوحة الإدارة (إلزامي لتفعيلها) ----
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-a-strong-password

# ---- التنبيهات ----
# قبل كم دقيقة من الموعد يُرسل تذكير للعميل والفني
REMINDER_MINUTES=60
REMINDERS_ENABLED=true
# رقم صاحب المحل لاستلام إشعار كل حجز جديد
OWNER_PHONE=

# ---- واتساب: log | twilio | meta ----
# log: يطبع الرسائل في الكونسول فقط (وضع الاختبار)
WHATSAPP_PROVIDER=log

# Twilio WhatsApp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Meta WhatsApp Cloud API
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_TOKEN=
META_GRAPH_API_VERSION=v21.0
# اسم قالب تأكيد الحجز المعتمد من Meta، ومتغيراته بالترتيب:
# {{1}} الاسم {{2}} الرقم {{3}} التاريخ {{4}} الموعد {{5}} نوع المكيف {{6}} العنوان {{7}} رابط الخريطة
META_TEMPLATE_CUSTOMER_CONFIRMATION=
META_TEMPLATE_LANGUAGE=ar
